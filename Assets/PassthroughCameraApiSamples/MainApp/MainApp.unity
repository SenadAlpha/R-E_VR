--- !u!114 &834115895
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 834115894}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e18235db99398cd4691b7387ce38a7af, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelRoot: {fileID: 627313399}
  bodyText: {fileID: 16951472}
  closeButton: {fileID: 2070013265}
  cameraRig: {fileID: 1119754808}
  openDistance: 0.6
  helpContent: "\uBA54\uC778 \uBA54\uB274\uB294 \uC67C\uCABD \uCEE8\uD2B8\uB864\uB7EC\uC758
    \uBA54\uB274(\u2261) \uBC84\uD2BC\uC73C\uB85C \uC5F4\uACE0 \uB2EB\uC2B5\uB2C8\uB2E4.\n\n\uD14D\uC2A4\uD2B8:
    3D \uD14D\uC2A4\uD2B8\uB97C \uC0DD\uC131\uD558\uACE0 \uC0C9\uC0C1, \uBC30\uACBD,
    \uD06C\uAE30\uB97C \uD3B8\uC9D1\uD569\uB2C8\uB2E4.\n\uC0AC\uC9C4: \uC2E4\uC2DC\uAC04
    \uD328\uC2A4\uC2A4\uB8E8 \uD654\uBA74\uC744 \uD655\uB300\uD574 \uCEA1\uCC98\uD558\uACE0
    \uC774\uBBF8\uC9C0\uB85C \uBC30\uCE58\uD569\uB2C8\uB2E4.\n\uC885\uC774 \uC2A4\uCE94:
    \uC885\uC774\uC758 \uB124 \uBAA8\uC11C\uB9AC\uB97C \uC790\uB3D9\uC73C\uB85C \uC778\uC2DD\uD574
    \uD3C9\uBA74 \uC774\uBBF8\uC9C0\uB85C \uC800\uC7A5\uD569\uB2C8\uB2E4.\n\uADF8\uB9AC\uAE30:
    \uD654\uC774\uD2B8\uBCF4\uB4DC\uB97C \uBC30\uCE58\uD558\uACE0 \uCEE8\uD2B8\uB864\uB7EC
    \uD2B8\uB9AC\uAC70\uB85C \uADF8\uB9BD\uB2C8\uB2E4.\n\uAC16\uACE0\uB180\uAE30:
    \uC170\uC774\uB354 \uB370\uBAA8, \uC624\uBE0C\uC81D\uD2B8 \uC778\uC2DD, \uACF5\uB180\uC774,
    \uCF58\uD150\uCE20 \uBC30\uCE58, \uC0C1\uC790 \uC0DD\uC131 \uB4F1\uC744 \uC5FD\uB2C8\uB2E4.\n\n\uBC30\uCE58\uB41C
    \uC624\uBE0C\uC81D\uD2B8\uB294 \uD2B8\uB9AC\uAC70\uB85C \uC120\uD0DD\uD558\uBA74
    \uC774\uB3D9/\uD68C\uC804, \uC218\uC815(\uD574\uB2F9 \uC2DC), \uC0AD\uC81C \uBA54\uB274\uAC00
    \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\uB450 \uC190\uC73C\uB85C \uC7A1\uACE0 \uBC8C\uB9AC\uAC70\uB098
    \uBAA8\uC73C\uBA74 \uD06C\uAE30\uB97C \uC870\uC808\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBCBD
    \uADFC\uCC98\uB85C \uC774\uB3D9\uD558\uBA74 \uC790\uB3D9\uC73C\uB85C \uBCBD\uC5D0
    \uB9DE\uCDB0 \uC815\uB82C\uB429\uB2C8\uB2E4.\nB \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
    \uC120\uD0DD\uC774 \uCDE8\uC18C\uB429\uB2C8\uB2E4."
